{
  "name": "ticket-manager-cli",
  "version": "1.0.0",
  "description": "Reference/example implementation for Week 2 (Ticket Manager CLI, TDD) and Week 3 (Knowledge Base API integration) of the MindX engineer onboarding curriculum.",
  "private": true,
  "license": "UNLICENSED",
  "bin": {
    "tickets": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "pretest": "npm run build",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "kb-server": "npm run build && node dist/server/runKbServer.js",
    "dev:kb-server": "ts-node src/server/runKbServer.ts",
    "start": "node dist/cli/index.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
